// Reglas de Firestore de Stock Hub (proyecto stock-hub-c5a0e). Parten de las del depósito (copia del 2026-10-22).
// NO están publicadas todavía en stock-hub-c5a0e: publicarlas a propósito, una vez, antes de usarlo.
// Todo lo que no está escrito acá queda CERRADO para navegadores y teléfonos: por eso mlPrivado y
// mlOauthStates (tokens de Mercado Libre) solo los tocan las funciones. No agregar un comodín general.
// PENDIENTE (libro de movimientos): las ventas/cancelaciones de ML las escriben solo las funciones; hoy cualquier
// usuario con rol de escritura puede crear `movimientos` desde la pantalla.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function ficha(emp) {
      return get(/databases/$(database)/documents/empresas/$(emp)/usuarios/$(request.auth.token.email));
    }
    function miembro(emp) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/empresas/$(emp)/usuarios/$(request.auth.token.email))
        && ficha(emp).data.activo == true;
    }
    function escribe(emp) {
      return miembro(emp) && ficha(emp).data.rol in ['admin', 'empleado'];
    }
    function admin(emp) {
      return miembro(emp) && ficha(emp).data.rol == 'admin';
    }

    match /empresas/{emp}/usuarios/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }
    match /empresas/{emp}/config/{id} {
      allow read: if miembro(emp);
      allow write: if admin(emp);
    }
    match /empresas/{emp}/productos/{id} {
      allow read: if miembro(emp);
      allow create, update: if escribe(emp);
      allow delete: if admin(emp);
    }
    // Copia de lo que dice ML de cada publicación: la escriben SOLO las funciones (mlSincronizar / mlImportar).
    match /empresas/{emp}/publicaciones/{id} {
      allow read: if miembro(emp);
      allow write: if false;
    }
    // Grabadora: cada aviso de ML tal cual. Lo escriben SOLO las funciones (mlAvisos / mlAvisoDetalle).
    match /empresas/{emp}/avisos/{id} {
      allow read: if miembro(emp);
      allow write: if false;
    }
    match /empresas/{emp}/stock/{id} {
      allow read: if miembro(emp);
      allow create, update, delete: if escribe(emp);
    }
    match /empresas/{emp}/movimientos/{id} {
      allow read: if miembro(emp);
      allow create: if escribe(emp) && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }
  }
}
