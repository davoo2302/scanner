rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario ve solo sus cuentas. Nadie escribe desde el navegador: lo hacen las Cloud Functions.
    match /cuentas/{cuentaId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow write: if false;

      match /publicaciones/{itemId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/cuentas/$(cuentaId)).data.ownerUid == request.auth.uid;
        allow write: if false;
      }

      // Tokens de Mercado Libre: jamás visibles desde el navegador.
      match /privado/{doc} {
        allow read, write: if false;
      }
    }

    match /oauthStates/{nonce} {
      allow read, write: if false;
    }
  }
}
